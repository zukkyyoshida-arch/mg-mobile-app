{
  "name": "mg-mobile-app",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* は SPA フォールバックより先に Worker で処理する
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mg-mobile-sync",
      // 本番反映前に `npx wrangler d1 create mg-mobile-sync` が表示する database_id へ差し替える。
      // ローカル検証（wrangler dev --local / d1 migrations apply --local）では、このままで動く。
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "workers_dev": true,
  "preview_urls": false
}
